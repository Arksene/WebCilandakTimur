// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DatabaseUrl")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

// 2. Tabel untuk Mengelola Berita
model Berita {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  judul     String
  isi       String
  gambar    String?
  tanggal   DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  Penulis   String?        @default("Kelurahan Cilandak Timur")
  kategori  KategoriBerita
}

enum KategoriBerita {
  PENGUMUMAN
  BERITA
}

// 3. Tabel untuk Informasi Kelurahan (Key-Value)
model InformasiKelurahan {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

// 4. Tabel untuk Dokumen Publik
model DokumenPublik {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  namaDokumen String
  fileUrl     String
  deskripsi   String?
  kategori    String?
  createdAt   DateTime @default(now())
}

// 5. Tabel untuk Layanan Publik
model LayananPublik {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  namaLayanan     String
  syarat          String
  kategoriLayanan String
}

// 6. Tabel untuk Data Wilayah
// 1. Model untuk Tabel "Batas Wilayah" (3 Kolom Teks)
model BatasWilayah {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  arah      String // Utara, Timur, Selatan, Barat
  batas     String // Contoh: "Jl. Kemang Selatan..."
  kelurahan String // Contoh: "Kelurahan Bangka"

  updatedAt DateTime @updatedAt
}

// 2. Model untuk Tabel "Demografi" (Jumlah Penduduk & Wilayah Administrasi)
model Statistik {
  id       String            @id @default(auto()) @map("_id") @db.ObjectId
  label    String // Contoh: "Laki-laki", "Perempuan", "RT", "RW"
  jumlah   Int // Contoh: 15108, 70
  kategori KategoriStatistik // Membedakan tabel kiri (Penduduk) atau kanan (Admin)

  updatedAt DateTime @updatedAt
}

enum KategoriStatistik {
  PENDUDUK // Untuk data Laki-laki / Perempuan
  WILAYAH // Untuk data RT / RW
}

// 7. Tabel untuk Pengaduan
model Pengaduan {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  namaPengadu  String
  email        String?
  isiPengaduan String
  buktiFotoUrl String
  status       Status   @default(PENDING)
  createdAt    DateTime @default(now())
}

enum Status {
  DITOLAK
  PENDING
  PROSES
  SELESAI
}
