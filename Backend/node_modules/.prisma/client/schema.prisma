// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DatabaseUrl")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

// 2. Tabel untuk Mengelola Berita
model Berita {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  judul     String
  isi       String
  gambar    String?
  tanggal   DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  Penulis   String?        @default("Kelurahan Cilandak Timur")
  kategori  KategoriBerita
}

enum KategoriBerita {
  PENGUMUMAN
  BERITA
}

// 3. Tabel untuk Informasi Kelurahan (Key-Value)
model InformasiKelurahan {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  key   String @unique
  value String
}

// 4. Tabel untuk Dokumen Publik
model DokumenPublik {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  namaDokumen String
  fileUrl     String
  kategori    String?
  createdAt   DateTime @default(now())
}

// 5. Tabel untuk Layanan Publik
model LayananPublik {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  nomor           Int?
  namaLayanan     String
  kategoriLayanan String
  syarat          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BatasWilayah {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  arah      String
  batas     String
  kelurahan String
  Kecamatan String?
  updatedAt DateTime @updatedAt
}

model Statistik {
  id       String            @id @default(auto()) @map("_id") @db.ObjectId
  label    String
  value    String?
  kategori KategoriStatistik

  updatedAt DateTime @updatedAt
}

enum KategoriStatistik {
  PENDUDUK
  WILAYAH
}

// 7. Tabel untuk Pengaduan
model Pengaduan {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  namaPengadu    String
  judulPengaduan String
  email          String?
  isiPengaduan   String
  buktiFotoUrl   String
  status         Status   @default(PENDING)
  createdAt      DateTime @default(now())
}

enum Status {
  DITOLAK
  PENDING
  PROSES
  SELESAI
}
